# ---------------------------------------------------------------
# 复制本文件为 .env 并填入真实密钥。.env 已被 .gitignore 排除。
#   cp .env.example .env
#
# 只要求 OpenAI 兼容协议（POST {BASE_URL}/chat/completions），
# 换厂商只改下面三个变量，代码一行都不用动。
# ---------------------------------------------------------------

# 必填：你的 API Key
LLM_API_KEY=sk-请替换成你的密钥

# 必填：接口地址。下面是常见厂商的地址，按你实际使用的填一行即可。
#   DeepSeek      https://api.deepseek.com/v1
#   通义千问       https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM      https://open.bigmodel.cn/api/paas/v4
#   Kimi 月之暗面  https://api.moonshot.cn/v1
#   OpenAI        https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 必填：模型名。常见取值：
#   DeepSeek      deepseek-chat
#   通义千问       qwen-plus
#   智谱 GLM      glm-4-plus
#   Kimi          moonshot-v1-32k
#   OpenAI        gpt-4o-mini
LLM_MODEL=deepseek-chat

# 可选：请求超时（秒），默认 45。出题时单次响应较长，不建议低于 30。
# LLM_TIMEOUT=45

# 可选：失败重试次数，默认 1。
# LLM_RETRIES=1
