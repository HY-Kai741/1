# ---------------------------------------------------------------
# 复制本文件为 .env 并填入真实密钥。.env 已被 .gitignore 排除。
#   cp .env.example .env
#
# 只要求 OpenAI 兼容协议（POST {BASE_URL}/chat/completions），
# 换厂商只改下面三个变量，代码一行都不用动。
# ---------------------------------------------------------------

# 必填：你的 API Key
LLM_API_KEY=sk-请替换成你的密钥

# 必填：接口地址。下面是常见厂商的地址，按你实际使用的填一行即可。
#   DeepSeek      https://api.deepseek.com/v1
#   通义千问       https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM      https://open.bigmodel.cn/api/paas/v4
#   Kimi 月之暗面  https://api.moonshot.cn/v1
#   OpenAI        https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 必填：模型名。常见取值：
#   DeepSeek      deepseek-chat
#   通义千问       qwen-plus
#   智谱 GLM      glm-4-plus
#   Kimi          moonshot-v1-32k
#   OpenAI        gpt-4o-mini
#   火山方舟       deepseek-v4-1-flash-260910 / doubao-seed-2-1-pro-260915（见 /api/v3/models）
LLM_MODEL=deepseek-chat

# 可选：请求超时（秒），默认 45。出题时单次响应较长，不建议低于 30。
# LLM_TIMEOUT=45

# 可选：失败重试次数，默认 1。
# LLM_RETRIES=1

# 可选：是否开启「深度思考」，默认 off。
# 推理模型（如火山方舟的 DeepSeek V4 系列）会把 max_tokens 全用在 reasoning_content 上，
# 导致正文为空、上层静默降级 —— 本项目只做措辞改写，不需要推理链，故默认关闭。
# LLM_THINKING=on   # 需要时再打开；端点不认该字段会自动降级重试
LLM_THINKING=off

# 可选：并行润色的线程数，默认 4（上限 8）。一条回答常引 3～6 条法条，
# 串行润色会把响应拖到十几秒，并发后首次约 2～4 秒、命中缓存后回到毫秒级。
# LLM_POLISH_WORKERS=4

# 可选：润色失败后的熔断秒数，默认 60。密钥失效或端点不可达时，
# 熔断期内直接跳过润色，避免把响应拖成长等待。
# LLM_FAIL_COOLDOWN=60
